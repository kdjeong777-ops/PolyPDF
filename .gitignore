# ===== PolyPDF .gitignore =====
# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Virtual env
.venv/
venv/
env/

# PyInstaller build output
build/
dist/
*.spec.bak
# 260628: PolyPDF.spec 은 build_ci.bat 실행 시 PyInstaller 가 **매번 자동 재생성**하는
#   산출물이다(수동 편집·주석은 다음 빌드에서 사라짐). 권위 있는 빌드 설정은 build_ci.bat.
PolyPDF.spec

# Large bundled runtime deps (download/install separately — see README)
ffmpeg.exe
ffmpeg*.zip
tesseract/
nltk_data/
# 릴리스/구성요소 산출물(저장소엔 넣지 않음 — 릴리스 자산으로만 업로드)
tesseract.zip
PolyPDF-*.zip
*-win64.zip

# Local user data / runtime artifacts (must NOT be committed)
index.db
settings.json
settings.*.bak.json
*.session.json

# Build/dev logs & scratch
build_log*.txt
build_*.log
*_err.log
selftest*.db
selftest*.log
_probe.*
_diag.*
_hltest.txt
_exe_err.log
gui*.png

# OS
Thumbs.db
.DS_Store

# NOTE intentionally NOT ignored (commit these):
#   viewer/  main.py  requirements.txt  build_ci.bat  run.bat
#   resources/  test_*.py  README.md  .github/
#   default_settings.json  (optional: a curated default profile to ship)

# 로컬 빌드 로그
_build_*.log

# ═══════════════════════════════════════════════════════════════════════
# 260628-7: ★ SOT(작업 계획서) 문서는 이 저장소에 절대 들어오지 않는다.
#
#   이 저장소는 **PUBLIC** 이고, SOT 문서는 내부 작업 계획서(백로그·실패 이력·
#   업무 파일명 포함)라 공개 대상이 아니다. 관리는 상위 MPDF 작업 저장소(private).
#   여기 공개해도 되는 .md 는 README.md 와 DEPLOY.md **둘뿐**이다.
#
#   아래 패턴은 '규칙'이 아니라 **차단 장치**다 — 실수로 복사해 와도 추적되지 않는다.
#   (의도적으로 공개해야 할 문서가 생기면 이 목록에서 빼는 판단을 먼저 한다.)
# ═══════════════════════════════════════════════════════════════════════
*작업 계획서.md
*작업계획서.md
*작업 지시서.md
뷰어 변경상세 아카이브.md
PDF 책갈피 분할 시스템.md
CLAUDE.md

# 260628-7: PyInstaller 중간 산출물(빌드 후 자동 삭제되지만 누락돼 있었다)
build/
